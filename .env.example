# Copy this file to .env. Never place real secrets in .env.example.

# Application
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_PORT=8000
FRONTEND_PORT=5173
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL + pgvector
POSTGRES_DB=lenny_growth
POSTGRES_USER=lenny
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://lenny:change-me-locally@localhost:5433/lenny_growth

# Provider selection
DEFAULT_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# Cloud provider (optional for local-only use)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Retrieval
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.52
CHUNK_TARGET_TOKENS=650
CHUNK_OVERLAP_TOKENS=100
EMBEDDING_BATCH_SIZE=16
TRANSCRIPT_REPOSITORY_URL=https://github.com/LennysNewsletter/lennys-newsletterpodcastdata.git
TRANSCRIPT_DATA_DIR=data/raw/lennys-newsletterpodcastdata

# Safety and timeouts
LLM_TIMEOUT_SECONDS=120
MAX_CHAT_INPUT_CHARS=10000
MAX_ARTIFACT_CHARS=100000
